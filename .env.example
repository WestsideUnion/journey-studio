# Journey Studio — Environment Variables

# Resend API Key for Project Inquiry Email Delivery
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient for inquiry notifications (Default: thejourneystudio2023@gmail.com)
INQUIRY_TO_EMAIL=thejourneystudio2023@gmail.com

# Verified sender email address in Resend (e.g. Journey Studio <onboarding@resend.dev> or contact@thejourneystudio.com)
INQUIRY_FROM_EMAIL=Journey Studio <onboarding@resend.dev>
