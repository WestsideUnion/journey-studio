# Journey Studio — Environment Variables

# Resend API Key for Project Inquiry Email Delivery
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient for inquiry notifications (Default: thejourneystudio2023@gmail.com)
INQUIRY_TO_EMAIL=thejourneystudio2023@gmail.com

# Verified sender email address in Resend (e.g. Journey Studio <onboarding@resend.dev> or contact@thejourneystudio.com)
INQUIRY_FROM_EMAIL=Journey Studio <onboarding@resend.dev>

# Sanity CMS & Studio CRM Configuration
# Obtain Project ID & Dataset from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-20

# Sanity API Write Token (Required for server-side form submissions to save leads into the CRM)
# Create with Editor/Write permissions under Sanity Project Settings > API > Tokens
SANITY_API_WRITE_TOKEN=sk_your_sanity_write_token
